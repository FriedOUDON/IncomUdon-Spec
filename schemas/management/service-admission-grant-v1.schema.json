{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friedoudon.github.io/incomudon-spec/schemas/management/service-admission-grant-v1.schema.json",
  "title": "IncomUdon Managed Service Admission v1 grant claims",
  "type": "object",
  "required": [
    "iss",
    "aud",
    "svc",
    "jti",
    "iat",
    "exp",
    "ch",
    "sid",
    "role",
    "perm",
    "cnf"
  ],
  "properties": {
    "iss": { "type": "string", "minLength": 1, "maxLength": 255 },
    "aud": { "type": "string", "minLength": 1, "maxLength": 255 },
    "svc": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "jti": { "type": "string", "minLength": 16, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" },
    "iat": { "type": "integer", "minimum": 0 },
    "exp": { "type": "integer", "minimum": 0 },
    "ch": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "sid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "role": { "enum": ["recorder", "observer", "automation"] },
    "perm": { "enum": [1, 3, 7] },
    "pri": { "type": "integer", "minimum": 1, "maximum": 255 },
    "cnf": {
      "type": "object",
      "required": ["jkt"],
      "properties": {
        "jkt": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
      },
      "additionalProperties": false
    },
    "grace_seconds": { "type": "integer", "minimum": 0, "maximum": 1800 }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "role": { "enum": ["recorder", "observer"] } }, "required": ["role"] },
      "then": { "properties": { "perm": { "const": 1 } }, "required": ["perm"] }
    },
    {
      "if": { "properties": { "perm": { "const": 7 } }, "required": ["perm"] },
      "then": { "required": ["pri"] },
      "else": { "not": { "required": ["pri"] } }
    }
  ]
}
