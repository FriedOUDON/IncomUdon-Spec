{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friedoudon.github.io/incomudon-spec/schemas/management/audit-retrieval-v1.schema.json",
  "title": "IncomUdon Management Plane audit retrieval v1 page",
  "type": "object",
  "required": [
    "schema_version",
    "records",
    "next_cursor"
  ],
  "properties": {
    "schema_version": {
      "const": "audit-retrieval-v1"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/auditRecord"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 512
    }
  },
  "additionalProperties": false,
  "$defs": {
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "auditRecord": {
      "type": "object",
      "required": [
        "record_id",
        "timestamp",
        "actor_type",
        "actor_id",
        "channel_id",
        "action",
        "result"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "actor_type": {
          "enum": [
            "identity",
            "service",
            "relay"
          ]
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "channel_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/u32"
            },
            {
              "type": "null"
            }
          ]
        },
        "action": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "result": {
          "enum": [
            "success",
            "denied",
            "failed"
          ]
        },
        "floor_interrupt": {
          "type": "object",
          "required": [
            "requester_priority",
            "replaced_sender_id",
            "replaced_priority"
          ],
          "properties": {
            "requester_priority": {
              "$ref": "#/$defs/priority"
            },
            "replaced_sender_id": {
              "oneOf": [
                {
                  "$ref": "#/$defs/u32"
                },
                {
                  "type": "null"
                }
              ]
            },
            "replaced_priority": {
              "oneOf": [
                {
                  "$ref": "#/$defs/priority"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "replaced_sender_id": {
                    "type": "null"
                  }
                },
                "required": [
                  "replaced_sender_id"
                ]
              },
              "then": {
                "properties": {
                  "replaced_priority": {
                    "type": "null"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "replaced_sender_id": {
                    "$ref": "#/$defs/u32"
                  }
                },
                "required": [
                  "replaced_sender_id"
                ]
              },
              "then": {
                "properties": {
                  "replaced_priority": {
                    "$ref": "#/$defs/priority"
                  }
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "floor_interrupt"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "floor_interrupt"
            ],
            "properties": {
              "actor_type": {
                "enum": [
                  "identity",
                  "service"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
