{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FriedOUDON/IncomUdon-Spec/schemas/directory-v3.schema.json",
  "title": "IncomUdon Directory UDP v3 envelope",
  "type": "object",
  "required": [
    "v",
    "type",
    "channelId",
    "epoch",
    "sequence",
    "expiresAt",
    "ciphertext"
  ],
  "properties": {
    "v": {
      "const": 3
    },
    "type": {
      "enum": [
        "snapshot",
        "participants",
        "request",
        "register",
        "heartbeat",
        "error"
      ]
    },
    "channelId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "epoch": {
      "type": "string",
      "minLength": 22,
      "maxLength": 22,
      "pattern": "^[A-Za-z0-9_-]{21}[AQgw]$",
      "description": "Canonical unpadded base64url encoding of exactly 16 raw epoch bytes."
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "ciphertext": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  },
  "additionalProperties": false
}
