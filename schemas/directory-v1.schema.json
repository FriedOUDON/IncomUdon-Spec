{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FriedOUDON/IncomUdon-Spec/schemas/directory-v1.schema.json",
  "title": "IncomUdon Directory UDP v1",
  "type": "object",
  "required": ["v", "type", "keyId", "epoch", "sequence", "expiresAt", "ciphertext"],
  "properties": {
    "v": {"const": 1},
    "type": {"enum": ["snapshot", "participants", "request", "register", "heartbeat"]},
    "keyId": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._-]+$"},
    "epoch": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "expiresAt": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "ciphertext": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_-]+$"}
  },
  "additionalProperties": false
}
