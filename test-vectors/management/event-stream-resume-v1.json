{
  "specVersion": "unreleased",
  "scheme": "management-sse-resume-v1",
  "cursor_semantics": "exclusive",
  "delivery_mode_cases": [
    {
      "name": "disabled_event_stream_is_unavailable",
      "event_delivery": "disabled",
      "request": {},
      "expected_status": 404
    },
    {
      "name": "live_initial_connection_delivers_subsequent_events_only",
      "event_delivery": "live",
      "request": {},
      "expected_status": 200,
      "replay": "none",
      "expected_delivery": "subsequently_emitted_authorized_events_only"
    },
    {
      "name": "live_eventsource_reconnect_ignores_last_event_id",
      "event_delivery": "live",
      "request": {
        "last_event_id": "150"
      },
      "expected_status": 200,
      "ignored_headers": [
        "Last-Event-ID"
      ],
      "replay": "none",
      "expected_delivery": "subsequently_emitted_authorized_events_only"
    },
    {
      "name": "live_reconnect_ignores_malformed_last_event_id",
      "event_delivery": "live",
      "request": {
        "last_event_id": "not-a-decimal-cursor"
      },
      "expected_status": 200,
      "ignored_headers": [
        "Last-Event-ID"
      ],
      "replay": "none",
      "expected_delivery": "subsequently_emitted_authorized_events_only"
    },
    {
      "name": "live_rejects_explicit_since_cursor",
      "event_delivery": "live",
      "request": {
        "since": "150"
      },
      "expected_status": 400
    },
    {
      "name": "replay_initial_connection_delivers_subsequent_events_only",
      "event_delivery": "replay",
      "request": {},
      "expected_status": 200,
      "replay": "none",
      "expected_delivery": "subsequently_emitted_authorized_events_only"
    },
    {
      "name": "replay_reconnect_skips_filtered_event_id_gaps",
      "event_delivery": "replay",
      "request": {
        "last_event_id": "150"
      },
      "selected_cursor": "150",
      "selected_cursor_source": "Last-Event-ID",
      "retained_event_ids": ["140", "150", "151", "152", "153", "157"],
      "authorized_event_ids": ["140", "150", "153", "157"],
      "expected_first_event_id": "153",
      "expected_status": 200
    },
    {
      "name": "replay_rejects_malformed_last_event_id",
      "event_delivery": "replay",
      "request": {
        "last_event_id": "not-a-decimal-cursor"
      },
      "expected_status": 400
    }
  ],
  "cases": [
    {
      "name": "initial_replay_uses_first_retained_authorized_event_after_since",
      "request": {
        "since": "100"
      },
      "selected_cursor": "100",
      "selected_cursor_source": "since",
      "retained_event_ids": ["100", "104", "109"],
      "authorized_event_ids": ["100", "104", "109"],
      "expected_first_event_id": "104"
    },
    {
      "name": "reconnect_uses_first_retained_authorized_event_after_last_event_id",
      "request": {
        "last_event_id": "150"
      },
      "selected_cursor": "150",
      "selected_cursor_source": "Last-Event-ID",
      "retained_event_ids": ["140", "150", "151", "152", "153", "157"],
      "authorized_event_ids": ["140", "150", "153", "157"],
      "expected_first_event_id": "153"
    },
    {
      "name": "last_event_id_takes_precedence_over_since",
      "request": {
        "since": "100",
        "last_event_id": "150"
      },
      "selected_cursor": "150",
      "selected_cursor_source": "Last-Event-ID",
      "ignored_query_parameters": [
        "since"
      ],
      "retained_event_ids": ["100", "104", "150", "151", "153"],
      "authorized_event_ids": ["100", "104", "150", "153"],
      "expected_first_event_id": "153"
    },
    {
      "name": "malformed_selected_cursor_is_bad_request",
      "request": {
        "last_event_id": "not-a-cursor"
      },
      "expected_status": 400
    },
    {
      "name": "unavailable_selected_cursor_viewer_resynchronizes_from_snapshot",
      "request": {
        "last_event_id": "150"
      },
      "caller_channel_roles": ["viewer"],
      "cursor_state": "different_management_service_instance",
      "expected_status": 410,
      "required_client_actions": [
        "discard_expired_cursor",
        "fetch_fresh_participant_snapshot",
        "open_cursor_free_live_stream"
      ]
    },
    {
      "name": "unavailable_selected_cursor_auditor_only_resynchronizes_without_snapshot",
      "request": {
        "last_event_id": "150"
      },
      "caller_channel_roles": ["auditor"],
      "cursor_state": "no_longer_retained",
      "expected_status": 410,
      "forbidden_client_actions": [
        "fetch_participant_snapshot"
      ],
      "required_client_actions": [
        "discard_expired_cursor",
        "record_event_history_discontinuity",
        "open_cursor_free_live_stream"
      ],
      "optional_client_actions": [
        "retrieve_authorized_audit_records"
      ],
      "expected_recovery_stream": {
        "request": {},
        "replay": "none",
        "event_scope": "subsequently_emitted_authorized_events_only"
      }
    }
  ]
}
