{
  "specVersion": "v0.7.0-draft",
  "scheme": "management-sse-resume-v1",
  "cursor_semantics": "exclusive",
  "cases": [
    {
      "name": "initial_replay_uses_since",
      "request": {
        "since": "100"
      },
      "selected_cursor": "100",
      "selected_cursor_source": "since",
      "expected_first_event_id": "101"
    },
    {
      "name": "reconnect_uses_last_event_id",
      "request": {
        "last_event_id": "150"
      },
      "selected_cursor": "150",
      "selected_cursor_source": "Last-Event-ID",
      "expected_first_event_id": "151"
    },
    {
      "name": "last_event_id_takes_precedence_over_since",
      "request": {
        "since": "100",
        "last_event_id": "150"
      },
      "selected_cursor": "150",
      "selected_cursor_source": "Last-Event-ID",
      "ignored_query_parameters": [
        "since"
      ],
      "expected_first_event_id": "151"
    },
    {
      "name": "malformed_selected_cursor_is_bad_request",
      "request": {
        "last_event_id": "not-a-cursor"
      },
      "expected_status": 400
    },
    {
      "name": "unavailable_selected_cursor_viewer_resynchronizes_from_snapshot",
      "request": {
        "last_event_id": "150"
      },
      "caller_channel_roles": ["viewer"],
      "cursor_state": "different_management_service_instance",
      "expected_status": 410,
      "required_client_actions": [
        "discard_expired_cursor",
        "fetch_fresh_participant_snapshot",
        "open_cursor_free_live_stream"
      ]
    },
    {
      "name": "unavailable_selected_cursor_auditor_only_resynchronizes_without_snapshot",
      "request": {
        "last_event_id": "150"
      },
      "caller_channel_roles": ["auditor"],
      "cursor_state": "no_longer_retained",
      "expected_status": 410,
      "forbidden_client_actions": [
        "fetch_participant_snapshot"
      ],
      "required_client_actions": [
        "discard_expired_cursor",
        "record_event_history_discontinuity",
        "open_cursor_free_live_stream"
      ],
      "optional_client_actions": [
        "retrieve_authorized_audit_records"
      ],
      "expected_recovery_stream": {
        "request": {},
        "replay": "none",
        "event_scope": "subsequently_emitted_authorized_events_only"
      }
    }
  ]
}
