{
  "specVersion": "v0.8.0-draft",
  "scheme": "membership-lease-v1",
  "serverConfig": {
    "maximumTalkSeconds": 60,
    "multiTalkEnabled": false,
    "maximumActiveTalkers": 1,
    "membershipLeaseSeconds": 30,
    "keepaliveIntervalSeconds": 10,
    "payloadHex": "003c0001001e000a"
  },
  "bootstrap": {
    "keepaliveIntervalSeconds": 5,
    "appliesUntil": "valid_SERVER_CONFIG_received"
  },
  "cases": [
    {
      "name": "idle_keepalive_refreshes_membership",
      "leaseSeconds": 30,
      "keepaliveIntervalSeconds": 10,
      "joinAcceptedAtSeconds": 0,
      "refreshPackets": [
        {
          "type": "KEEPALIVE",
          "receivedAtSeconds": 10,
          "expectedDeadlineSeconds": 40
        },
        {
          "type": "KEEPALIVE",
          "receivedAtSeconds": 20,
          "expectedDeadlineSeconds": 50
        }
      ],
      "expectedMembershipAtSeconds": 49
    },
    {
      "name": "accepted_active_media_refreshes_membership",
      "leaseSeconds": 30,
      "keepaliveIntervalSeconds": 10,
      "joinAcceptedAtSeconds": 0,
      "refreshPackets": [
        {
          "type": "AUDIO",
          "receivedAtSeconds": 8,
          "expectedDeadlineSeconds": 38
        },
        {
          "type": "FEC",
          "receivedAtSeconds": 18,
          "expectedDeadlineSeconds": 48
        }
      ],
      "expectedMembershipAtSeconds": 47
    },
    {
      "name": "ping_does_not_refresh_membership",
      "leaseSeconds": 30,
      "joinAcceptedAtSeconds": 0,
      "nonRefreshPackets": [
        {
          "type": "PING",
          "receivedAtSeconds": 10
        },
        {
          "type": "PING",
          "receivedAtSeconds": 20
        }
      ],
      "expectedExpiryAtSeconds": 30,
      "expectedActiveTalkReleaseReason": "MEMBERSHIP_TIMEOUT"
    },
    {
      "name": "invalid_keepalive_ratio_is_rejected",
      "membershipLeaseSeconds": 30,
      "keepaliveIntervalSeconds": 11,
      "expectedServerConfigAcceptance": false
    },
    {
      "name": "existing_membership_uses_join_snapshot_after_reload",
      "joinSnapshot": {
        "membershipLeaseSeconds": 30,
        "keepaliveIntervalSeconds": 10
      },
      "reloadedPolicy": {
        "membershipLeaseSeconds": 60,
        "keepaliveIntervalSeconds": 20
      },
      "expectedExistingMembership": {
        "membershipLeaseSeconds": 30,
        "keepaliveIntervalSeconds": 10
      },
      "expectedNewMembership": {
        "membershipLeaseSeconds": 60,
        "keepaliveIntervalSeconds": 20
      }
    }
  ],
  "controlAuthenticationRefreshCases": [
    {
      "name": "required_unauthenticated_ptt_on_does_not_refresh",
      "controlAuthentication": {
        "mode": "required",
        "channelHasConfiguredControlKey": true
      },
      "leaseSeconds": 30,
      "joinAcceptedAtSeconds": 0,
      "packet": {
        "type": "PTT_ON",
        "receivedAtSeconds": 10,
        "authenticated": false
      },
      "expectedPacketAcceptance": false,
      "expectedMembershipRefresh": false,
      "expectedDeadlineSeconds": 30
    },
    {
      "name": "required_authenticated_ptt_request_refreshes",
      "controlAuthentication": {
        "mode": "required",
        "channelHasConfiguredControlKey": true
      },
      "leaseSeconds": 30,
      "joinAcceptedAtSeconds": 0,
      "packet": {
        "type": "PTT_REQUEST",
        "receivedAtSeconds": 10,
        "authenticated": true
      },
      "expectedPacketAcceptance": true,
      "expectedMembershipRefresh": true,
      "expectedDeadlineSeconds": 40
    },
    {
      "name": "optional_unconfigured_unauthenticated_keepalive_refreshes",
      "controlAuthentication": {
        "mode": "optional",
        "channelHasConfiguredControlKey": false
      },
      "leaseSeconds": 30,
      "joinAcceptedAtSeconds": 0,
      "packet": {
        "type": "KEEPALIVE",
        "receivedAtSeconds": 10,
        "authenticated": false
      },
      "expectedPacketAcceptance": true,
      "expectedMembershipRefresh": true,
      "expectedDeadlineSeconds": 40
    },
    {
      "name": "optional_unconfigured_unauthenticated_codec_config_refreshes",
      "controlAuthentication": {
        "mode": "optional",
        "channelHasConfiguredControlKey": false
      },
      "leaseSeconds": 30,
      "joinAcceptedAtSeconds": 0,
      "packet": {
        "type": "CODEC_CONFIG",
        "receivedAtSeconds": 10,
        "authenticated": false
      },
      "expectedPacketAcceptance": true,
      "expectedMembershipRefresh": true,
      "expectedDeadlineSeconds": 40
    },
    {
      "name": "off_unauthenticated_ptt_off_refreshes",
      "controlAuthentication": {
        "mode": "off",
        "channelHasConfiguredControlKey": false
      },
      "leaseSeconds": 30,
      "joinAcceptedAtSeconds": 0,
      "packet": {
        "type": "PTT_OFF",
        "receivedAtSeconds": 10,
        "authenticated": false
      },
      "expectedPacketAcceptance": true,
      "expectedMembershipRefresh": true,
      "expectedDeadlineSeconds": 40
    },
    {
      "name": "off_malformed_ptt_on_does_not_refresh",
      "controlAuthentication": {
        "mode": "off",
        "channelHasConfiguredControlKey": false
      },
      "leaseSeconds": 30,
      "joinAcceptedAtSeconds": 0,
      "packet": {
        "type": "PTT_ON",
        "receivedAtSeconds": 10,
        "authenticated": false,
        "valid": false
      },
      "expectedPacketAcceptance": false,
      "expectedMembershipRefresh": false,
      "expectedDeadlineSeconds": 30
    }
  ]
}
